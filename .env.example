# --- Base de données ---
# Postgres (Neon, Railway, Supabase... n'importe quel Postgres géré fait l'affaire)
DATABASE_URL="postgresql://user:password@localhost:5432/realtystudio"

# --- Auth (NextAuth / Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"

# --- IA : analyse photos, storyboard, descriptifs ---
ANTHROPIC_API_KEY=""

# --- IA : génération vidéo (Kling via Replicate), staging virtuel, retouche photo ---
REPLICATE_API_TOKEN=""
# Modèle Kling (image-to-video) utilisé pour transformer chaque photo du storyboard en plan vidéo
REPLICATE_VIDEO_MODEL="kwaivgi/kling-v1.6-standard"
# Modèle testé par le fondateur pour l'habillage virtuel des pièces vides
REPLICATE_STAGING_MODEL="proplabs/virtual-staging"
# Modèle de retouche/amélioration photo — à choisir après tests (ex: upscaler, relighting)
REPLICATE_PHOTO_ENHANCE_MODEL=""

# --- Stockage fichiers (photos / vidéos) ---
# Cloudflare R2 (compatible S3, pas de frais de sortie)
STORAGE_ENDPOINT=""
STORAGE_BUCKET="realtystudio-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# --- Réseaux sociaux (Phase 4 — pas nécessaire pour le MVP vidéo/descriptif) ---
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Worker ---
# Intervalle de polling des jobs en attente (ms)
WORKER_POLL_INTERVAL_MS="5000"
